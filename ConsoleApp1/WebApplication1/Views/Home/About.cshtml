@{
    ViewData["Title"] = "About Me";
}

<div class="container">

    <div class="text-center mb-5">
        <h1>About Me</h1>
        <hr class="w-25 mx-auto">
    </div>

    <div class="row">

        <div class="col-lg-12">

            <h3>Biography</h3>

            <p class="about-text">
                @ViewData["Biography1"]
            </p>
            <p class="about-text">
                @ViewData["Biography2"]
            </p>

        </div>

    </div>

    <div class="row mt-5">

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Educational Background
                    </h4>

                    <ul>
                        <li>
                            @ViewData["Course"]
                        </li>
                        <li>
                            @ViewData["School"]
                        </li>
                        <li>
                            @ViewData["S.Y."]
                        </li>
                    </ul>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Career Goals & Interests
                    </h4>

                    <ul>
                        <li>
                            @ViewData["CareerGoal1"]
                        </li>
                        <li>
                            @ViewData["CareerGoal2"]
                        </li>
                        <li>
                            @ViewData["Interest1"]
                        </li>
                        <li>
                            @ViewData["Interest2"]
                        </li>
                        <li>
                            @ViewData["Interest3"]
                        </li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>