@{
    ViewData["Title"] = "Home";
}

<div class="row align-items-center">

    <div class="col-lg-4 text-center mb-4">
        <img src="~/images/Gio.jpg"
             class="img-fluid rounded-circle shadow"
             alt="Profile Picture"
             style="max-width:300px;">
    </div>

    <div class="col-lg-8">

        <h1>@ViewData["Name"]</h1>

        <h3>@ViewData["ProTitle"]</h3>

        <p class="intro-text">
            @ViewData["Introduction"]
        </p>

        <div class="mt-4">

            <a asp-controller="Home"
               asp-action="Projects"
               class="btn btn-primary me-2">
                View Projects
            </a>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-outline-primary">
                Contact Me
            </a>

        </div>

    </div>

</div>