@{
    ViewData["Title"] = "Home";
}

<div class="row align-items-center">

    <div class="col-lg-4 text-center mb-4">
        <img src="~/images/Gio.jpg"
             class="img-fluid rounded-circle shadow"
             alt="Profile Picture"
             style="max-width:300px;">
    </div>

    <div class="col-lg-8">

        <h1 class="display-4">
            Gio N. Fernandez
        </h1>

        <h3 class="text-primary mb-4">
            IT Undergraduate
        </h3>

        <p class="intro-text">
            Hi, I'm Gio Fernandez, a BSIT student at Lyceum of Alabang with a passion for technology and continuous learning.
            As an aspiring IT professional, I love sharpening my strategic thinking through chess and video games while working toward a bright, balanced future in the tech industry.
        </p>

        <div class="mt-4">

            <a asp-controller="Home"
               asp-action="Projects"
               class="btn btn-primary me-2">
                View Projects
            </a>

            <a asp-controller="Home"
               asp-action="Contact"
               class="btn btn-outline-primary">
                Contact Me
            </a>

        </div>

    </div>

</div>