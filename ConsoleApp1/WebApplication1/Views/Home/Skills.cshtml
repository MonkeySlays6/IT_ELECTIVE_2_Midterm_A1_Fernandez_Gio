@{
    ViewData["Title"] = "Skills";
}

<div class="container">

    <div class="text-center mb-5">
        <h1>My Skills</h1>
        <hr class="w-25 mx-auto">
        <p class="lead">
            Below are some of my technical skills and the tools I use.
        </p>
    </div>

    <div class="row g-4">

        <!-- Programming Languages -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Programming Languages
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">C#</li>
                        <li class="list-group-item">Java</li>
                        <li class="list-group-item">Python</li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Web Technologies -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Web Technologies
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">HTML</li>
                        <li class="list-group-item">CSS</li>
                        <li class="list-group-item">Bootstrap</li>
                        <li class="list-group-item">ASP.NET Core MVC</li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Databases -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Databases
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">Microsoft Access</li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Development Tools -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Development Tools
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">Visual Studio</li>
                        <li class="list-group-item">NetBeans</li>
                        <li class="list-group-item">PyCharm</li>
                        <li class="list-group-item">Git</li>
                        <li class="list-group-item">GitHub</li>

                    </ul>

                </div>

            </div>
        </div>

    </div>

</div>