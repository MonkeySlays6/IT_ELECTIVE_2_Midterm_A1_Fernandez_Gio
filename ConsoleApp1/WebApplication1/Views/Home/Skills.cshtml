@{
    ViewData["Title"] = "Skills";
}

<div class="container">

    <div class="text-center mb-5">
        <h1>My Skills</h1>
        <hr class="w-25 mx-auto">
        <p class="lead">
            Below are some of my technical skills and the tools I use.
        </p>
    </div>

    <div class="row g-4">

        <!-- Programming Languages -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Programming Languages
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">@ViewData["Language1"]</li>
                        <li class="list-group-item">@ViewData["Language2"]</li>
                        <li class="list-group-item">@ViewData["Language3"]</li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Web Technologies -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Web Technologies
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">
                            @ViewData["WebTech1"]
                        </li>
                        <li class="list-group-item">@ViewData["WebTech2"]</li>
                        <li class="list-group-item">@ViewData["WebTech3"]</li>
                        <li class="list-group-item">@ViewData["WebTech4"]</li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Databases -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Databases
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">
                            @ViewData["Database"]
                        </li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Development Tools -->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Development Tools
                    </h4>

                    <hr>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">@ViewData["DevTool1"]</li>
                        <li class="list-group-item">@ViewData["DevTool2"]</li>
                        <li class="list-group-item">@ViewData["DevTool3"]</li>
                        <li class="list-group-item">@ViewData["DevTool4"]</li>
                        <li class="list-group-item">@ViewData["DevTool5"]</li>

                    </ul>

                </div>

            </div>
        </div>

    </div>

</div>